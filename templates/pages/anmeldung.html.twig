{% extends 'base.html.twig' %}

{% block title %}{{ pageMeta.title|default('Anmeldung') ~ ' — Seepferdchen‑Garde' }}{% endblock %}

{% block body_class %}{{ app.request.query.get('submit') ? 'form-success-shown' : '' }}{% endblock %}

{% block body %}
  <div class="container my-4 my-lg-5">
    <div class="row justify-content-center">
      <div class="glass-panel">
      {# Everything in this block disappears once the request was sent (screen and print) #}
      <div data-hide-on-success>
      <h1>Anfrage für einen Schwimmkurs</h1>

      <p class="lead mb-3">
        Sie möchten Ihr Kind für einen Schwimmkurs bei der Seepferdchen‑Garde anmelden?<br>
        Über das untenstehende Formular können Sie eine Anfrage für einen Kursplatz stellen.
      </p>

      <p class="mb-2">
        Nach Eingang Ihrer Anfrage prüfe ich, ob zum gewünschten Zeitpunkt noch ein freier Platz verfügbar ist.<br>
        Sollte ein passender Kursplatz frei sein, erhalten Sie von mir eine persönliche Bestätigung mit allen weiteren Informationen.
      </p>

      <div class="alert alert-info booking-notice mb-3" role="note">
        <p class="fw-bold mb-2">Bitte beachten Sie:</p>
        <ul class="mb-0">
          <li>Eine verbindliche Teilnahme am Schwimmkurs kommt erst mit meiner ausdrücklichen Bestätigung des Kursplatzes zustande.</li>
          <li>Nach der Bestätigung ist der reservierte Kursplatz verbindlich für Ihr Kind eingeplant.</li>
        </ul>
      </div>

      <p class="lead mb-1">Ich freue mich auf Ihre Anfrage!</p>

      <p class="text-body-secondary mb-4">Nach dem Absenden erhalten Sie eine E‑Mail mit einem Bestätigungslink. Erst nach Klick auf den Link wird Ihre Anfrage berücksichtigt.</p>
      </div>

      {% set submit = app.request.query.get('submit') %}
      {% set error = app.request.query.get('error') %}
      {% set success = submit %}

      <div id="booking-success"
           data-success-container
           class="{{ success ? 'alert alert-success mb-3' : 'visually-hidden' }}"
           aria-hidden="{{ success ? 'false' : 'true' }}"
           {% if success %}role="alert"{% endif %}>
        {% if success %}
          {% include '_partials/booking_summary.html.twig' with { booking: booking|default(null) } %}
        {% endif %}
      </div>

      <div id="booking-error"
           class="{{ error ? 'alert alert-danger mb-3' : 'visually-hidden' }}"
           aria-hidden="{{ error ? 'false' : 'true' }}"
           {% if error %}role="alert"{% endif %}>
        {% if error %}
          {% if error == 'rate' %}
            Bitte warten Sie einen Moment, bevor Sie das Formular erneut absenden.
          {% elseif error == 'mail' %}
            <strong>Ihre Anfrage wurde gespeichert!</strong> Allerdings konnte die Bestätigungs-E-Mail nicht versendet werden.
            Wir werden uns umgehend bei Ihnen melden. Falls Sie innerhalb von 24 Stunden nichts von uns hören, kontaktieren Sie uns bitte direkt.
          {% elseif error == 'db' %}
            Es ist ein technischer Fehler aufgetreten und Ihre Anfrage konnte nicht gespeichert werden.
            Bitte versuchen Sie es in wenigen Minuten erneut oder kontaktieren Sie uns direkt.
          {% else %}
            Es ist ein Fehler aufgetreten. Bitte prüfen Sie Ihre Eingaben und versuchen Sie es erneut.
          {% endif %}
        {% endif %}
      </div>

      <noscript>
        {% if success %}
          <div class="alert alert-success">
            Vielen Dank! Bitte prüfen Sie Ihr Postfach und bestätigen Sie Ihre Anfrage über den Link in der E‑Mail.
          </div>
        {% elseif error %}
          <div class="alert alert-danger">
            {% if error == 'rate' %}
              Bitte warten Sie einen Moment, bevor Sie das Formular erneut absenden.
            {% elseif error == 'mail' %}
              <strong>Ihre Anfrage wurde gespeichert!</strong> Allerdings konnte die Bestätigungs-E-Mail nicht versendet werden.
              Wir werden uns umgehend bei Ihnen melden.
            {% elseif error == 'db' %}
              Es ist ein technischer Fehler aufgetreten. Bitte versuchen Sie es später erneut.
            {% else %}
              Es ist ein Fehler aufgetreten. Bitte prüfen Sie Ihre Eingaben und versuchen Sie es erneut.
            {% endif %}
          </div>
        {% endif %}
      </noscript>

      {{ form_start(form, {
        action: path('app_booking'),
        attr: {
          class: 'vstack gap-3 mt-3 needs-validation',
          novalidate: 'novalidate',
          'data-api-url': path('api_booking'),
          'data-success-target': 'booking-success',
          'data-error-target': 'booking-error'
        }
      }) }}

      <h2 class="h4 mt-2">Kurszeitraum</h2>

      <div class="row g-3">
        <div class="col-12">
          <p class="lead mb-1">
            Der Kurs wird <strong>wöchentlich am Dienstag</strong> durchgeführt.<br>
            Der <strong>Kursbeginn wird derzeit geplant</strong> und von mir Ihnen mitgeteilt.<br>
            Die Kurszeit <strong>16:00–16:45 Uhr</strong> ist derzeit <strong>ausgebucht</strong>.
          </p>
        </div>
      </div>

      {#
      <div class="row g-3">
        <div class="col-12">
          <p class="lead"><strong>Kursbeginn:</strong> Dienstag, den 04.11.2025 bis zum 27.01.2026 (jeden Dienstag)<br>
            <em class="text-info">In den Weihnachtsferien vom 22. Dezember 2025 bis zum 6. Januar 2026 findet kein Kurs statt</em></p>
        </div>
      </div>
      #}
      <div class="row g-1">
        <div class="col-12 col-md-6 mb-2">
          <div class="form-floating">
            {{ form_widget(form.desiredTimeSlot) }}
            {{ form_label(form.desiredTimeSlot) }}
          </div>
          {{ form_errors(form.desiredTimeSlot) }}
        </div>
        {{ form_widget(form.coursePeriod) }}
      </div>

      <div class="col-12">
        <p class="lead mb-1"><strong>Ort:</strong> <a href="https://maps.app.goo.gl/dDAyGnimfYUQYJHU9" target="_blank" rel="noopener">Regenbogenschule in Herzogenrath</a></p>
      </div>

      <h2 class="h4 mt-1">Kosten</h2>
      <ul class="mb-1">
        <li><strong>Kursgebühr:</strong> 200&nbsp;€</li>
        <li><strong>Umfang:</strong> 10× 45 Minuten (<em>10 Stunden á 20&nbsp;€</em>)</li>
        <li><strong>Inklusive:</strong> Offizielle Seepferdchen‑Prüfung</li>
      </ul>

      <div class="col-12 col-md-6">
        <div class="form-floating">
          {{ form_widget(form.paymentMethod) }}
          {{ form_label(form.paymentMethod) }}
        </div>
        {{ form_errors(form.paymentMethod) }}
      </div>

      <h2 class="h4 mt-3">Kinderdaten</h2>

      <div class="row g-3">
        <div class="col-12 col-md-6">
          {{ form_label(form.childName) }}
          {{ form_widget(form.childName) }}
          {{ form_errors(form.childName) }}
        </div>
        <div class="col-12 col-md-6">
          {{ form_label(form.childBirthdate) }}
          {{ form_widget(form.childBirthdate) }}
          {{ form_errors(form.childBirthdate) }}
        </div>
        <div class="col-12">
          {{ form_label(form.childAddress) }}
          {{ form_widget(form.childAddress) }}
          {{ form_errors(form.childAddress) }}
        </div>
      </div>

      <h2 class="h4 mt-3">Allgemeine Angaben</h2>

      <div class="row g-3">
        <div class="col-12">
          {{ form_label(form.hasSwimExperience) }}<br>
          {{ form_widget(form.hasSwimExperience) }}
          {{ form_errors(form.hasSwimExperience) }}
        </div>
        <div class="col-12">
          {{ form_label(form.swimExperienceDetails) }}
          {{ form_widget(form.swimExperienceDetails) }}
          {{ form_errors(form.swimExperienceDetails) }}
        </div>
        <div class="col-12">
          {{ form_label(form.healthNotes) }}
          {{ form_widget(form.healthNotes) }}
          {{ form_errors(form.healthNotes) }}
        </div>
        <div class="col-12">
          {{ form_label(form.maySwimWithoutAid) }}<br>
          {{ form_widget(form.maySwimWithoutAid) }}
          {{ form_errors(form.maySwimWithoutAid) }}
        </div>
      </div>

      <h2 class="h4 mt-3">Eltern / Erziehungsberechtigte</h2>

      <div class="row g-3">
        <div class="col-12 col-md-6">
          {{ form_label(form.parentName) }}
          {{ form_widget(form.parentName) }}
          {{ form_errors(form.parentName) }}
        </div>
        <div class="col-12 col-md-6">
          {{ form_label(form.parentEmail) }}
          {{ form_widget(form.parentEmail) }}
          {{ form_errors(form.parentEmail) }}
        </div>
        <div class="col-12">
          {{ form_label(form.parentPhone) }}
          {{ form_widget(form.parentPhone) }}
          {{ form_errors(form.parentPhone) }}
        </div>
      </div>

      <h2 class="h4 mt-3">Organisatorisches</h2>

      <div class="row g-3">
        <div class="col-12">
          {{ form_label(form.isMemberOfClub) }}<br>
          {{ form_widget(form.isMemberOfClub) }}
          {{ form_errors(form.isMemberOfClub) }}
        </div>
      </div>

      <h2 class="h4 mt-3">Einverständnisse</h2>
      <div class="row g-2">
        <div class="col-12 form-check">
          {{ form_widget(form.participationConsent) }}
          {{ form_label(form.participationConsent) }}
          {{ form_errors(form.participationConsent) }}
        </div>
        <div class="col-12 form-check">
          {{ form_widget(form.liabilityAcknowledged) }}
          {{ form_label(form.liabilityAcknowledged) }}
          {{ form_errors(form.liabilityAcknowledged) }}
        </div>
        <div class="col-12 form-check">
          {{ form_widget(form.photoConsent) }}
          {{ form_label(form.photoConsent) }}
          {{ form_errors(form.photoConsent) }}
        </div>
        <div class="col-12 form-check">
          {{ form_widget(form.dataConsent) }}
          {{ form_label(form.dataConsent) }}
          {{ form_errors(form.dataConsent) }}
        </div>
        <div class="col-12 form-check">
          {{ form_widget(form.bookingConfirmation) }}
          {{ form_label(form.bookingConfirmation) }}
          {{ form_errors(form.bookingConfirmation) }}
        </div>
      </div>

      {# Spam trap: display:none so browsers never autofill it #}
      <div hidden aria-hidden="true">
        {{ form_widget(form.hp_check) }}
      </div>

      <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="submit" class="btn btn-cta">Kursplatz anfragen</button>
        <a href="/docs/2025.11-voanmeldung-schwimmkurs.pdf" class="btn btn-outline-secondary" target="_blank" rel="noopener">Formular als Dokument</a>
      </div>

      <p class="form-text mb-0">Hinweis: Sie erhalten eine E‑Mail mit einem Bestätigungslink. Die Teilnahme wird erst mit meiner ausdrücklichen Bestätigung des Kursplatzes verbindlich.</p>

      {{ form_rest(form) }}
      {{ form_end(form) }}

      </div>
    </div>
  </div>
{% endblock %}
