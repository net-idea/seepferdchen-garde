{
  "name": "seepferdchen-garde",
  "description": "Website with small management for the swimming school 'Seepferdchen Garde' by Riccardo Nappa",
  "license": "MIT",
  "private": true,
  "author": "Adam Ibrom <adam@net-i.de>",
  "contributors": [
    "Adam Ibrom <adam@net-i.de>",
    "Riccardo Nappa <mail@seepferdchen-garde.de>"
  ],
  "scripts": {
    "start": "bash ./develop.sh",
    "dev-server": "encore dev-server",
    "dev": "encore dev",
    "watch": "encore dev --watch",
    "build": "encore production --progress",
    "deploy": "bash ./deploy.sh",
    "tsc:check": "tsc --noEmit",
    "tsc:watch": "tsc --noEmit -w",
    "lint:css": "stylelint 'assets/**/*.{css,scss}' 'templates/email/_partials/**/*.css'",
    "lint:css:fix": "stylelint 'assets/**/*.{css,scss}' 'templates/email/_partials/**/*.css' --fix",
    "og:build": "node generate-og.js"
  },
  "dependencies": {
    "core-js": "^3.50.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@symfony/webpack-encore": "^7.2.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "bootstrap": "^5.3.8",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "postcss": "^8.5.28",
    "postcss-scss": "^4.0.9",
    "sass": "^1.104.0",
    "sass-loader": "^17.0.1",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "browserslist": [
    "defaults",
    "not dead"
  ]
}
